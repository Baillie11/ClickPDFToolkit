<?xml version="1.0" encoding="UTF-8"?>
<policymap>
  <policy domain="delegate" rights="none" pattern="*" />
  <policy domain="filter" rights="none" pattern="*" />
  <policy domain="coder" rights="none" pattern="*" />
  <policy domain="coder" rights="read" pattern="{PNG,JPEG,GIF,WEBP,TIFF,AVIF,HEIC,HEIF}" />
  <policy domain="coder" rights="read|write" pattern="PNG" />
  <policy domain="coder" rights="write" pattern="INFO" />
  <policy domain="path" rights="none" pattern="@*" />
  <policy domain="path" rights="none" pattern="|*" />
  <policy domain="resource" name="memory" value="384MiB" />
  <policy domain="resource" name="map" value="0" />
  <policy domain="resource" name="disk" value="0" />
  <policy domain="resource" name="thread" value="1" />
  <policy domain="resource" name="time" value="20" />
  <policy domain="resource" name="width" value="25MP" />
  <policy domain="resource" name="height" value="25MP" />
</policymap>
